NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bears_den
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_TTL=1h
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=./uploads
RATE_MAX=300
AUTH_RATE_MAX=20
ADMIN_EMAIL=admin@bearsden.local
ADMIN_PASSWORD=ChangeThisAdminPass1
# Demo shop
PUBLIC_BASE_URL=http://localhost:3000   # MUST be a URL your phone can open for the QR code to work (LAN IP or tunnel/HTTPS domain)
DEMO_TAX_BP=1800                         # demo tax in basis points (1800 = 18%)
DEMO_SESSION_TTL_MIN=30                  # minutes before a demo QR session expires
CHECKOUT_RATE_MAX=30
